<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Копировать инструкции, настройки и шаблон keywords.txt рядом с .exe -->
  <ItemGroup>
    <Content Include="instructions/**/*" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="settings.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="keywords.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10" />
  </ItemGroup>

</Project>
